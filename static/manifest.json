{
  "manifest_version": 3,
  "name": "Mispriced",
  "short_name": "Mispriced",
  "description": "See the market you're on priced on other prediction market venues, after fees, in a side panel. Compares prices only.",
  "version": "0.0.0",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": {
    "default_title": "Mispriced",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "side_panel": { "default_path": "panel.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["https://polymarket.com/*", "https://limitless.exchange/*", "https://app.opinion.trade/*", "https://predict.fun/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["sidePanel", "storage", "alarms"],
  "host_permissions": [
    "https://polymarket.com/*",
    "https://kalshi.com/*",
    "https://limitless.exchange/*",
    "https://app.opinion.trade/*",
    "https://predict.fun/*",
    "https://app.hyperliquid.xyz/*",
    "https://live.mispriced.fi/*"
  ],
  "commands": {
    "open-panel": { "suggested_key": { "default": "Alt+Shift+M" }, "description": "Open the Mispriced side panel" }
  }
}
